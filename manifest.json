{
  "manifest_version": 3,
  "name": "Essence Scholar",
  "version": "1.9.9",
  "description": "Import academic PDFs into your Essence Scholar library with one click. Automatically detects PDFs as you browse or download.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "webRequest",
    "webNavigation",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "id": "pdf-collector",
      "js": [
        "pdf-collector.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "id": "ssrn-browse",
      "js": [
        "ssrn-browse.js"
      ],
      "matches": [
        "https://papers.ssrn.com/*",
        "https://www.ssrn.com/*",
        "https://ssrn.com/*"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "id": "app-bridge",
      "js": [
        "app-bridge.js"
      ],
      "matches": [
        "https://essencescholar.com/*",
        "https://*.essencescholar.com/*",
        "https://essence-scholar-website-nightly.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.min.js",
        "pdf.worker.min.js",
        "pdf-init.js",
        "shared-id-generator.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}